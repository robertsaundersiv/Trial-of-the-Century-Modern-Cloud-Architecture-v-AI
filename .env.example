# Copy to .env and paste the temporary credentials from the Udacity "Cloud Resources" page.
# .env is git-ignored. These are used only by the AWS CLI scripts in infra/,
# never by the Lambda function (it gets credentials from its IAM role).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=us-east-1
STACK_NAME=objection-inspection
